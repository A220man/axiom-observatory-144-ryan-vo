# Application
APP_NAME=axiom-observatory
VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./data/axiom.db

# LLM Provider (simulated, openai_compatible, anthropic, gemini, ollama)
LLM_PROVIDER=simulated
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Keycloak (for production)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=axiom
KEYCLOAK_CLIENT_ID=axiom-frontend
KEYCLOAK_CLIENT_SECRET=